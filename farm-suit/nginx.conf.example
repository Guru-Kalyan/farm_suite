# ==============================================================================
# FARM SUIT — NGINX PRODUCTION REVERSE PROXY CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file on your Ubuntu server:
#    sudo cp nginx.conf.example /etc/nginx/sites-available/farm_suite
# 2. Edit domain/IP if needed:
#    sudo nano /etc/nginx/sites-available/farm_suite
# 3. Enable site:
#    sudo ln -sf /etc/nginx/sites-available/farm_suite /etc/nginx/sites-enabled/
# 4. Test and reload Nginx:
#    sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

server {
    listen 80;
    server_name 68.233.112.55 localhost; # Set to your server IP or domain name

    client_max_body_size 25M;

    # --------------------------------------------------------------------------
    # 1. Backend API Proxy (Gunicorn running via PM2 on port 8000)
    # --------------------------------------------------------------------------
    location /api/ {
        # DO NOT put a trailing slash after 8000 (keep as http://127.0.0.1:8000)
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # --------------------------------------------------------------------------
    # 2. Django Admin / Backend Static Files
    # (Generated after running: python manage.py collectstatic)
    # --------------------------------------------------------------------------
    location /static/ {
        alias /home/ubuntu/farm_suite/backend/staticfiles/;
        expires 30d;
        access_log off;
    }

    # --------------------------------------------------------------------------
    # 3. React Frontend SPA
    # OPTION A: PM2 Vite Preview (running on port 3000)
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $http_host;
        proxy_cache_bypass $http_upgrade;
    }

    # OPTION B (High Performance Alternative):
    # Direct static files served by Nginx without Node.js RAM overhead.
    # To use this instead of Option A, comment Option A above and uncomment below:
    # location / {
    #     root /home/ubuntu/farm_suite/frontend/dist;
    #     index index.html index.htm;
    #     try_files $uri $uri/ /index.html;
    # }
}
